PORT=3120
SALT_ROUND=5
SECRET_KEY=bebas
NODE_ENV=development

# Database Configuration (PostgreSQL running on port 1000)
DB_USER=postgres
DB_PASSWORD=admin
DB_NAME=cms-fmd
DB_HOST=localhost
DB_PORT=1000

# ==============================================================================
# Cloudinary Configuration
# ==============================================================================
# LOGIKA FITUR UPLOAD:
# 1. Jika variabel CLOUDINARY_* (atau CLOUDINARY_URL) disertakan dan bernilai valid,
#    fitur upload Cloudinary AKTIF dan gambar otomatis disimpan ke cloud.
# 2. Jika variabel CLOUDINARY_* TIDAK disertakan atau dibiarkan kosong,
#    fitur upload Cloudinary TIDAK BERJALAN dan server otomatis menyimpan file
#    ke penyimpanan lokal (folder /uploads) tanpa error.
# ==============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
